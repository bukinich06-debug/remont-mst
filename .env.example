# Form lead → Telegram (same keys in Vercel → Environment Variables)
#
# TELEGRAM_BOT_TOKEN — from @BotFather
#
# Upstash Redis (free) — stores who pressed /start (Vercel cannot use local files):
# 1. https://console.upstash.com → Create Redis database
# 2. REST API → copy URL and token
#
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# After deploy on Vercel, set webhook once (replace DOMAIN and TOKEN):
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://DOMAIN/api/telegram/webhook
#
# Anyone who sends /start to the bot receives form leads. No TELEGRAM_CHAT_ID.
#
# Local: copy to .env, pnpm dev. Without a public URL, /start is picked up via getUpdates on submit.

TELEGRAM_BOT_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
